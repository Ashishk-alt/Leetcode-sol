class Solution {
    HashSet<List<Integer>> set = new HashSet<>();
    public void getAllCombinations(int[] arr, int idx, int target,List<List<Integer>> ans, List<Integer>combin){
        // Base case
        if (idx == arr.length || target < 0) {
            return;
        }
        // Target reached
        if (target == 0) {
            if (!set.contains(combin)) {
                ans.add(new ArrayList<>(combin));
                set.add(new ArrayList<>(combin));
            }
            return;
        }
        // Include current element
        combin.add(arr[idx]);

        // Single choice: move to next index
        getAllCombinations(arr, idx + 1, target - arr[idx], ans, combin);

        // Multiple choice: stay at same index
        getAllCombinations(arr, idx, target - arr[idx], ans, combin);

        // Backtrack
        combin.remove(combin.size() - 1);

        // Exclusion: don't take current element
        getAllCombinations(arr, idx + 1, target, ans, combin);
    }
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        List<List<Integer>> ans = new ArrayList<>();
        List<Integer> combin = new ArrayList<>();
        getAllCombinations(candidates, 0, target, ans, combin);
        return ans;
    }
}
