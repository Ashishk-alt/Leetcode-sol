class Solution {

    // Helper function
    public boolean isPossible(int[] arr, int n, int m, int maxAllowedTime) {

        int painters = 1;
        int time = 0;

        for (int i = 0; i < n; i++) {

            if (time + arr[i] <= maxAllowedTime) {
                time += arr[i];
            } else {
                painters++;
                time = arr[i];
            }
        }

        return painters <= m;
    }

    // Main function
    public int minTimeToPaint(int[] arr, int n, int m) {

        int sum = 0;
        int maxVal = Integer.MIN_VALUE;

        // Find total time and maximum board length
        for (int i = 0; i < n; i++) {
            sum += arr[i];
            maxVal = Math.max(maxVal, arr[i]);
        }

        // Binary search range
        int st = maxVal;
        int end = sum;
        int ans = -1;

        while (st <= end) {

            int mid = st + (end - st) / 2;

            if (isPossible(arr, n, m, mid)) {
                // mid is possible, try for a smaller answer
                ans = mid;
                end = mid - 1;
            } else {
                // mid is not possible, need more time
                st = mid + 1;
            }
        }

        return ans;
    }
}
