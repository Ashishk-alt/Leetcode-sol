class Solution {
    public int singleNonDuplicate(int[] A) {
        int n = A.length;
        //if array has single element
        if (n == 1) {
            return A[0];
        }
        int st = 0;
        int end = n - 1;

        while (st <= end) {
            int mid = st + (end - st) / 2;
            // If mid is the first element
            if (mid == 0 && A[0] != A[1]) {
                return A[mid];
            }
            // If mid is the last element
            if (mid == n - 1 && A[n - 1] != A[n - 2]) {
                return A[mid];
            }

            // Check if mid itself is the single element
            if (A[mid - 1] != A[mid] && A[mid] != A[mid + 1]) {
                return A[mid];
            }
            // mid is even
            if (mid % 2 == 0) {
                if (A[mid - 1] == A[mid]) {
                    end = mid - 1;
                } else {
                    st = mid + 1;
                }
            } 
            // mid is odd
            else {
                if (A[mid - 1] == A[mid]) {
                    st = mid + 1;
                } else {
                    end = mid - 1;
                }
            }
        }
        return -1;
    }
}
