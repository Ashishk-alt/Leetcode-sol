class MinStack {
    Stack<Long> s;
    long minVal;
    public MinStack() {
        s = new Stack<>();
    }
    public void push(int val) {
        if (s.empty()) {
            s.push((long) val);
            minVal = val;
        } 
        else {
            if (val < minVal) {
                s.push(2L * val - minVal);
                minVal = val;
            } 
            else {
                s.push((long) val);
            }
        }
    }
    public void pop() {
        if (s.peek() < minVal) {
            minVal = 2 * minVal - s.peek();
        }

        s.pop();
    }

    public int top() {
        if (s.peek() < minVal) {
            return (int) minVal;
        }

        return (int) (long) s.peek();
    }
    public int getMin() {
        return (int) minVal;
    }
}
