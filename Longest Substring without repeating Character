class Solution {
    public int lengthOfLongestSubstring(String s) {
        int n = s.length();
        int si = 0;
        int ei =0;
        int dup = 0;
        int maxLength = 0;
        int[] f = new int[128]; 
        while(ei<n){
            if(f[s.charAt(ei)]== 1){
                dup = 1;
            }
            f[s.charAt(ei)]++;
            ei++;
            while(dup==1){
                if(f[s.charAt(si)]== 2){
                    dup=0;
                }
                f[s.charAt(si)]--;
                si++;
            }
            maxLength = Math.max(maxLength, ei-si);
        }
        return maxLength;
    }
}
