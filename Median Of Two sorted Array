class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int[] smaller;
        int[] larger;

        // Make nums1 the smaller array
        if (nums1.length <= nums2.length) {
            smaller = nums1;
            larger = nums2;
        } else {
            smaller = nums2;
            larger = nums1;
        }
        int totalLength = smaller.length + larger.length;
        int low = 0;
        int high = smaller.length;

        while (low <= high) {
            // Partition in smaller array
            int partitionX = low + (high - low) / 2;

            // Partition in larger array
            int partitionY = (totalLength + 1) / 2 - partitionX;

            // Left and right elements of smaller array
            int l1;
            int r1;

            if (partitionX == 0) {
                l1 = Integer.MIN_VALUE;
            } else {
                l1 = smaller[partitionX - 1];
            }
            if (partitionX == smaller.length) {
                r1 = Integer.MAX_VALUE;
            } else {
                r1 = smaller[partitionX];
            }

            // Left and right elements of larger array
            int l2;
            int r2;

            if (partitionY == 0) {
                l2 = Integer.MIN_VALUE;
            } else {
                l2 = larger[partitionY - 1];
            }
            if (partitionY == larger.length) {
                r2 = Integer.MAX_VALUE;
            } else {
                r2 = larger[partitionY];
            }

            // Correct partition
            if (l1 <= r2 && l2 <= r1) {
                // Even total length
                if (totalLength % 2 == 0) {
                    int leftMax = Math.max(l1, l2);
                    int rightMin = Math.min(r1, r2);
                    return (leftMax + rightMin) / 2.0;
                }
                // Odd total length
                else {
                    return Math.max(l1, l2);
                }
            }
            // We have taken too many elements from smaller array
            else if (l1 > r2) {
                high = partitionX - 1;
            }
            // We need to take more elements from smaller array
            else {
                low = partitionX + 1;
            }
        }
        return 0.0;
    }
}
