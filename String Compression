class Solution {
    public int compress(char[] chars) {
        int n = chars.length;
        int idx = 0;

        for (int i = 0; i < n; i++) {
            char ch = chars[i];
            int count = 0;
            // Count consecutive repeating characters
            while (i < n && chars[i] == ch) {
                count++; 
                i++;
            }
            if (count == 1) {
                chars[idx++] = ch;
            } else {
                chars[idx++] = ch;
                // Convert integer count to String and append each digit
                String str = Integer.toString(count);
                for (char dig : str.toCharArray()) {
                    chars[idx++] = dig;
                }
            }
            i--; // Adjust loop index since while loop incremented it past the group
        }     
        return idx; 
    }
}
