class Solution {
    public int splitArray(int[] nums, int k) {
        int sum = 0;
        int max = 0;

        // Find total sum and largest element
        for (int i = 0; i < nums.length; i++) {
            sum += nums[i];
            max = Math.max(max, nums[i]);
        }
        int st = max;
        int end = sum;
        int ans = -1;

        // Binary search on answer
        while (st <= end) {
            int mid = st + (end - st) / 2;
            if (isValid(nums, k, mid)) {
                ans = mid;
                end = mid - 1;
            } else {
                st = mid + 1;
            }
        }
        return ans;
    }

    private boolean isValid(int[] nums, int k, int maxAllowedSum) {
        int subarrays = 1;
        int sum = 0;

        for (int i = 0; i < nums.length; i++) {
            if (sum + nums[i] <= maxAllowedSum) {
                sum += nums[i];
            } else {
                subarrays++;
                sum = nums[i];
            }
        }
        return subarrays <= k;
    }
}
