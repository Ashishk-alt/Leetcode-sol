class Solution {
    public int largestRectangleArea(int[] heights) {
        int n = heights.length;
        int[] left = new int[n];
        int[] right = new int[n];

        Stack<Integer> s = new Stack<>();

        // Right smaller
        for (int i = n - 1; i >= 0; i--) {
            while (s.size() > 0 && heights[s.peek()] >= heights[i]) {
                s.pop();
            }
            if (s.empty()) {
                right[i] = n;
            } else {
                right[i] = s.peek();
            }
            s.push(i);
        }
        while (!s.empty()) {
            s.pop();
        }

        // Left smaller
        for (int i = 0; i < n; i++) {
            while (s.size() > 0 && heights[s.peek()] >= heights[i]) {
                s.pop();
            }
            if (s.empty()) {
                left[i] = -1;
            } else {
                left[i] = s.peek();
            }
            s.push(i);
        }

        int ans = 0;
        for (int i = 0; i < n; i++) {
            int width = right[i] - left[i] - 1;
            int currArea = heights[i] * width;
            ans = Math.max(ans, currArea);
        }
        return ans;
    }
}
