import java.util.*;
public class Solution {
    public void reverseString(char[] s) {
        Stack<Character> stack = new Stack<>();
        int idx = 0;     
        // 1. Use s.length (no parentheses) and s[idx] for arrays
        while (idx < s.length) {
            stack.push(s[idx]);
            idx++;
        }     
        // 2. Overwrite the original array in-place instead of returning a new string
        idx = 0;
        while (!stack.isEmpty()) {
            s[idx] = stack.pop();
            idx++;
        }
    }
}
