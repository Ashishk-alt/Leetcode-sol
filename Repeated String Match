class Solution {
    public int repeatedStringMatch(String a, String b) {
        int n = a.length();
        int m = b.length();
        String tp = a;
        int ans = 1;

        while (tp.length() < b.length()) {
            tp += a;
            ans++;
        }
        if (ck(tp, b)) {
            return ans;
        }
        if (ck(tp + a, b)) {
            return ans + 1;
        }
        return -1;
    }
    boolean ck(String a, String b) {
        int n = a.length();
        int m = b.length();

        for (int i = 0; i <= n - m; i++) {
            int j;

            for (j = 0; j < m; j++) {
                if (a.charAt(i + j) != b.charAt(j)) {
                    break;
                }
            }
            if (j == m) {
                return true;
            }
        }
        return false;
    }
}
