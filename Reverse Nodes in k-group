class Solution {
    public ListNode reverseKGroup(ListNode head, int k) {
        ListNode temp = head;
        int cnt = 0;

        // Check if k nodes exist
        while (cnt < k) {
            if (temp == null) {
                return head;
            }
            temp = temp.next;
            cnt++;
        }

        // Recursively reverse the remaining list
        ListNode prevNode = reverseKGroup(temp, k);

        // Reverse current group
        temp = head;
        cnt = 0;

        while (cnt < k) {
            ListNode next = temp.next;
            temp.next = prevNode;

            prevNode = temp;
            temp = next;

            cnt++;
        }
        return prevNode;
    }
}
