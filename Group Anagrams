class Solution { 
    public List<List<String>> groupAnagrams(String[] strs) {
        // Check for empty inputs
        if (strs == null || strs.length == 0) {
            return new ArrayList<>();
        }   
        Map<String, List<String>> frequencyStringsMap = new HashMap<>();      
        // Classic for loop using index counter
        for (int i = 0; i < strs.length; i++) {
            String str = strs[i];
            String frequencyString = getFrequencyString(str);
            
            frequencyStringsMap.computeIfAbsent(frequencyString, k -> new ArrayList<>()).add(str);
        }       
        return new ArrayList<>(frequencyStringsMap.values());
    }
    
    private String getFrequencyString(String str) {
        int[] freq = new int[26];
        
        // Classic loop over string characters using charAt(j)
        for (int j = 0; j < str.length(); j++) {
            char c = str.charAt(j);
            freq[c - 'a']++;
        }     
        // Create the frequency string (e.g., "a1b2c0...")
        StringBuilder frequencyString = new StringBuilder("");
        char c = 'a';
        
        // Classic loop over the frequency array
        for (int k = 0; k < freq.length; k++) {
            int frequencyCount = freq[k];
            frequencyString.append(c);
            frequencyString.append(frequencyCount);
            c++;
        }       
        return frequencyString.toString();
    }
}
