import java.util.Stack;
public class Solution {
    public int firstUniqChar(String s) {
        int[] counts = new int[26];
        // Stack to store indices of potential unique characters
        Stack<Integer> stack = new Stack<>();
        
        // Traverse the string from right to left
        for (int i = s.length() - 1; i >= 0; i--) {
            char ch = s.charAt(i);
            counts[ch - 'a']++;
            
            // Push current index onto the stack
            stack.push(i);
            
            // Pop elements from the top of the stack if they are no longer unique
            while (!stack.isEmpty() && counts[s.charAt(stack.peek()) - 'a'] > 1) {
                stack.pop();
            }
        }
        
        // If stack is not empty, the top element is the first unique character's index
        return stack.isEmpty() ? -1 : stack.peek();
    }
}
