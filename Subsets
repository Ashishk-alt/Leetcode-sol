import java.util.*;
class Solution {
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        List<Integer> temp = new ArrayList<>();

        printSubsets(nums, temp, ans, 0);
        return ans;
    }
    public void printSubsets(int[] arr, List<Integer> temp,List<List<Integer>> ans, int i){
        if (i == arr.length) {
            ans.add(new ArrayList<>(temp));
            return;
        }

        // Include
        temp.add(arr[i]);
        printSubsets(arr, temp, ans, i + 1);

        // Backtrack
        temp.remove(temp.size() - 1);

        // Exclude
        printSubsets(arr, temp, ans, i + 1);
    }
}
